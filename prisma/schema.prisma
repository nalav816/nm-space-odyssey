generator client {
  provider = "prisma-client"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  username     String  @id
  passwordHash String
  isGuest      Boolean @default(true)
  netWorth     Int

  astronauts         OwnedAstronauts[]
  unlockedAstronauts UnlockedAstronauts[]
}

model OwnedAstronauts {
  id                  String   @id @default(uuid())
  username            String
  astronautName       String
  lastCurrencyUpdate  DateTime @default(now())
  isGeneratingDollars Boolean  @default(false)
  occupiedRoom        Int      @default(1)
  occupiedSlot        Int      @default(1)

  astronautData Astronauts @relation(fields: [astronautName], references: [name])
  owner         User       @relation(fields: [username], references: [username])
}

model UnlockedAstronauts {
  astronautName String @id
  username      String

  astronautData Astronauts @relation(fields: [astronautName], references: [name])
  owner         User       @relation(fields: [username], references: [username])
}

model Astronauts {
  name             String  @id
  rating           Int
  price            Int
  modelUrl         String
  shopIconUrl      String
  isEngineer       Boolean
  isScientist      Boolean @default(false)
  isPilot          Boolean
  hiddenOnLock     Boolean @default(false)
  dollarsPerSecond Int     @default(0)

  ownedAstronauts    OwnedAstronauts[]
  unlockedAstronauts UnlockedAstronauts[]
}
